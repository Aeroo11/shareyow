# Salin berkas ini menjadi `.env`, lalu isi dari dasbor Supabase.
#
# ---------------------------------------------------------------------------
# YANG DIPAKAI: PUBLISHABLE KEY. Bukan secret key.
# ---------------------------------------------------------------------------
#
# Supabase mengganti nama kuncinya; yang berubah hanya namanya:
#
#   publishable  (sb_publishable_...)  = dulu bernama "anon"          → PAKAI INI
#   secret       (sb_secret_...)       = dulu bernama "service_role"  → JANGAN
#
# Publishable key memang dirancang untuk ditanam di aplikasi klien dan terlihat
# siapa pun — yang menjaga data bukan kerahasiaannya, melainkan Row Level
# Security di sisi basis data.
#
# Secret key MELEWATI SELURUH RLS. Menaruhnya di sini berarti membundelnya ke
# dalam aplikasi yang dipasang orang lain, dan siapa pun yang membongkar bundel
# itu bisa membaca serta menghapus data semua pengguna. Kalau pernah tidak
# sengaja terpakai, cabut kuncinya di dasbor dan buat yang baru.
#
# Aplikasi tetap berjalan penuh tanpa berkas ini; yang mati hanya sinkronisasi.

EXPO_PUBLIC_SUPABASE_URL=https://mpywzhcvyqlkywbubpuo.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
