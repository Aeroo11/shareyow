# Salin berkas ini menjadi `.env`, lalu isi dari dasbor Supabase:
# Settings → API
#
# Keduanya boleh terlihat publik. Anon key memang dirancang untuk ditanam di
# aplikasi klien; yang menjaga data adalah Row Level Security, bukan kerahasiaan
# key ini.
#
# JANGAN PERNAH menaruh `service_role` key di sini atau di mana pun dekat kode
# klien — ia melewati seluruh RLS.
#
# Aplikasi tetap berjalan penuh tanpa berkas ini; yang mati hanya sinkronisasi.

EXPO_PUBLIC_SUPABASE_URL=https://mpywzhcvyqlkywbubpuo.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
